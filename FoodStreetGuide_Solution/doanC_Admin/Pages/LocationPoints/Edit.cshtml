@page "{id:int}"
@model doanC_Admin.Pages.LocationPoints.EditModel
@{
    ViewData["Title"] = "Sửa địa điểm";
}

<h2>Sửa địa điểm</h2>
<form method="post">
    <input type="hidden" asp-for="LocationPoint.PointId" />
    <div class="mb-3">
        <label>Tên</label>
        <input asp-for="LocationPoint.Name" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Mô tả</label>
        <textarea asp-for="LocationPoint.Description" class="form-control"></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Lưu</button>
    <a href="/LocationPoints" class="btn btn-secondary">Hủy</a>
</form>